{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Budgy",
  "version": "1.0.0",
  "identifier": "com.ari.budgy",
  "build": {
    "beforeDevCommand": "node src-tauri/scripts/sync-frontend.mjs",
    "beforeBuildCommand": "node src-tauri/scripts/sync-frontend.mjs",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Budgy — מעקב פיננסי",
        "width": 1200,
        "height": 860,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Hebrew", "English"],
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
