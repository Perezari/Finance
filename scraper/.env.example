# Copy to .env and fill in PUSH_SECRET. .env is gitignored — never commit it.
#
# There is deliberately no database key here. This machine talks only to the
# record-mortgage Edge Function, which can store a mortgage snapshot and
# nothing else; the service-role key stays inside the function.

SUPABASE_URL=https://hnkqsxzzdhbmqnwvslpi.supabase.co

# Your Budgy auth user id (Supabase -> Authentication -> Users -> your UID).
BUDGY_USER_ID=

# The x-push-secret shared with the send-push / record-mortgage functions.
# Supabase -> Edge Functions -> send-push -> the PUSH_SECRET constant.
PUSH_SECRET=

# ── Bank ──────────────────────────────────────────────
BANK_START_URL=https://sc.mizrahi-tefahot.co.il/TFHLogin/index.html#/login
BANK_INSTITUTION_ID=mizrahi

# Where the browser session lives. Keeping it means you may stay signed in
# between runs; the bank still decides how long that lasts.
# BROWSER_PROFILE_DIR=

# Secret embedded in the Safari bookmarklet. Supabase -> Edge Functions ->
# record-mortgage -> the BOOKMARKLET_SECRET constant.
BOOKMARKLET_SECRET=
